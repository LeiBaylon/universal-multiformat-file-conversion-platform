        "continueOnError": true
      },
      "steps": [
        {
          "id": "wf_s1",
          "tool": "bg-remover",
          "operationName": "Remove Image Background",
          "enabled": true,
          "config": {
            "modelPrecision": "fast",
            "outputFormat": "png",
            "backgroundMode": "transparent",
            "featherRadius": 1
          }
        },
        {
          "id": "wf_s2",
          "tool": "resize",
